---
// Signature: dichtes Netz aus driftenden Text-Fragmenten.
// Nodes = mehrere Wortfetzen zusammen, verbunden durch feine Linien ("Netz").
// Geerdet: Fragmente = "Buch der Unruhe", zersplittertes Ich = Heteronyme.
// Akzentfarbe wird aus der CSS-Variable --accent gelesen -> eine Quelle für alles.
---

<canvas class="particle-field" aria-hidden="true" data-particle-field></canvas>

<script>
  // ---- Tuning (hier drehen, wenn dir Dichte/Ruhe nicht passt) ----
  const DENSITY   = 11000; // kleiner = mehr Partikel
  const MAX_NODES = 95;    // Deckel
  const LINK_DIST = 150;   // px: bis hierhin werden Nodes vernetzt
  const SPEED     = 0.16;  // Driftgeschwindigkeit
  // ----------------------------------------------------------------

  const canvas = document.querySelector('[data-particle-field]');
  if (canvas instanceof HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

    // Farbe aus CSS-Variable ziehen (ändert sich mit, wenn du --accent anpasst)
    function hexToRgb(h) {
      h = h.trim().replace('#', '');
      if (h.length === 3) h = h.split('').map((c) => c + c).join('');
      const n = parseInt(h, 16);
      return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
    }
    const accentHex = getComputedStyle(document.documentElement)
      .getPropertyValue('--accent') || '#b490fc';
    const [AR, AG, AB] = hexToRgb(accentHex);

    // Wortfetzen + Dev-Glyphen — die zwei Identitäten vereint.
const pool = [
  // Pessoa / Literatur / Figuren
  'desassossego', 'Traum', 'Wille', 'Ich', 'Soares', 'Caeiro', 'Campos',
  'Reis', 'Bühne', 'Unruhe', 'sonhar', 'heteronym', 'Fragment', 'Sehnsucht',
  'nada', 'ser', 'não-ser', 'Kalvarienberg', 'wollen', 'reduzieren',

  // Literatur
  'Roman', 'Erzählung', 'Novelle', 'Prosa', 'Vers', 'Strophe', 'Zeile',
  'Absatz', 'Kapitel', 'Vorwort', 'Nachwort', 'Epilog', 'Prolog',
  'Anmerkung', 'Fußnote', 'Randnotiz', 'Zitat', 'Widmung', 'Motto',
  'Handlung', 'Figur', 'Erzähler', 'Stimme', 'Perspektive', 'Motiv',
  'Metapher', 'Allegorie', 'Parabel', 'Chiffre', 'Gleichnis',
  'Auslassung', 'Ellipse', 'Wiederholung', 'Variation', 'Echo',
  'Klammer', 'Zwischenraum', 'Leerraum', 'Bruch', 'Sprung', 'Pause',

  // Lesen / Buch
  'lesen', 'Lektüre', 'Lesart', 'Leser', 'Buch', 'Blatt', 'Seite',
  'Druck', 'Satz', 'Schrift', 'Typografie', 'Manuskript', 'Entwurf',
  'Korrektur', 'Rand', 'Rücken', 'Einband', 'Inhalt', 'Register',
  'Verzeichnis', 'Bibliothek', 'Archiv', 'Katalog', 'Exzerpt',
  'Notiz', 'Stelle', 'Passage', 'Abschnitt', 'Band', 'Ausgabe',
  'Auflage', 'Original', 'Übersetzung', 'Übertragung', 'Glossar',
  'Palimpsest', 'Konvolut', 'Nachlass', 'Faksimile',

  // Schreiben / Sprache
  'schreiben', 'Wort', 'Satz', 'Silbe', 'Laut', 'Stimme', 'Sprache',
  'Schweigen', 'sprechen', 'benennen', 'verschweigen', 'umschreiben',
  'übersetzen', 'deuten', 'lesen', 'verstehen', 'erinnern', 'vergessen',
  'sagen', 'unsagen', 'Namen', 'Bedeutung', 'Sinn', 'Unsinn',
  'Zeichen', 'Spur', 'Abdruck', 'Anfang', 'Ende', 'Dazwischen',

  // etwas philosophischer
  'Sein', 'Nichts', 'Werden', 'Zeit', 'Raum', 'Wahrheit', 'Wirklichkeit',
  'Möglichkeit', 'Zweifel', 'Erkenntnis', 'Bewusstsein', 'Erinnerung',
  'Vergessen', 'Abwesenheit', 'Gegenwart', 'Vergangenheit', 'Zukunft',
  'Fremdheit', 'Nähe', 'Distanz', 'Identität', 'Alterität', 'Kontingenz',
  'Existenz', 'Essenz', 'Leere', 'Endlichkeit', 'Unendlichkeit',
  'Verlust', 'Anwesenheit', 'Abwesenheit', 'Widerspruch', 'Ambivalenz',

  // schöne / präzise Wörter
  'Dämmerung', 'Zwielicht', 'Nachhall', 'Vorahnung', 'Nachbild',
  'Zwischenzeit', 'Zwischenraum', 'Gegenlicht', 'Nachtseite',
  'Innenraum', 'Außenwelt', 'Fernweh', 'Heimweh', 'Sehnsucht',
  'Melancholie', 'Schwermut', 'Unruhe', 'Stille', 'Vergeblichkeit',
  'Vergänglichkeit', 'Einsamkeit', 'Abgrund', 'Horizont', 'Ferne',
  'Ufer', 'Schatten', 'Spiegel', 'Staub', 'Nebel', 'Dunkel',
  'Licht', 'Flucht', 'Rückkehr', 'Irrweg', 'Umweg', 'Abwesenheit',

  // Portugiesisch
  'saudade', 'desassossego', 'sonho', 'sonhar', 'ser', 'nada',
  'ninguém', 'alma', 'mar', 'noite', 'silêncio', 'vontade',
  'verdade', 'mentira', 'tempo', 'longe', 'perto', 'talvez',
  'sempre', 'nunca', 'agora', 'ontem', 'amanhã', 'tudo', 'nada',

  // Französisch / literarisches Vokabular
  'ailleurs', 'rêve', 'oubli', 'souvenir', 'silence', 'vertige',
  'néant', 'absence', 'présence', 'écriture', 'lecture', 'marge',
  'fragment', 'hasard', 'ennui', 'désir', 'lueur', 'nuit',

  // Latein / Griechisch
  'nihil', 'esse', 'sum', 'memento', 'sine', 'finis', 'vita',
  'tempus', 'locus', 'verba', 'vox', 'ordo', 'fragmentum',
  'ἀλήθεια', 'λόγος', 'μνήμη', 'λήθη', 'τόπος', 'χρόνος',

  // Begriffe, die typografisch / konzeptuell funktionieren
  'etc.', 'sic', 'ibid.', 'cf.', 'N.B.', 'postscriptum', 'manus',
  'draft', 'fragment', 'untitled', 'no title', 'o. T.', 'ohne Titel',
  'verschwunden', 'unvollendet', 'vorläufig', 'wiedergefunden',
  'ungelesen', 'unlesbar', 'unübersetzt', 'unbenannt', 'unausgesprochen',

  // einzelne Verben
  'warten', 'zögern', 'irren', 'suchen', 'finden', 'verlieren',
  'bleiben', 'gehen', 'kommen', 'kehren', 'sehen', 'schauen',
  'träumen', 'erwachen', 'erinnern', 'vergessen', 'begehren',
  'zweifeln', 'schweigen', 'sprechen', 'lesen', 'schreiben',
  'streichen', 'löschen', 'bewahren', 'wiederholen', 'beginnen',
  'enden',

  // Zeichen / Typografie
  '{ }', '( )', '[ ]', '< >', '⟨ ⟩', '‹ ›', '« »', '„ “', '‚ ‘',
  '—', '–', '…', '·', '⁂', '※', '†', '‡', '§', '¶', '∞',
  '∅', '≠', '≈', '≡', '∴', '∵', '→', '←', '↔', '⇒', '⇢',
  '∴', '∵', '∼', '≈', '≠', '≤', '≥', '±', '×', '÷',
  '°', '′', '″', '※', '⁝', '⁙', '⁖', '⁘', '⁙',
  '⌁', '⌇', '⌘', '⟡', '◊', '◇', '○', '●', '□', '■',
  '░', '▒', '▓', '∞', '∅', '∎',

  // Code-/Markup-artige Zeichen, passend zum bestehenden Set
  '{ }', '{{ }}', '[]', '[…]', '()', '(...)', '<>', '<…>',
  '=>', '->', '<-', '<=>', '::', ':=', '==', '!=', '&&', '||',
  '//', '/*', '*/', '/**/', '...', '..', '…', '___', '__',
  '~/ ', './', '../', '#', '##', '@', '&', '|', '^', '~',
  ':::', ';;', ';;;', '---', '--', '++', '??', '?!', '!?',
  '/* fragment */', '// notiz', '...',

  // kleine Bruchstücke / Formulierungen
  'vielleicht', 'niemals', 'irgendwo', 'nirgendwo', 'anderswo',
  'dazwischen', 'dennoch', 'jedoch', 'womöglich', 'einst',
  'immer noch', 'nicht mehr', 'noch nicht', 'wieder',
  'zum ersten Mal', 'zum letzten Mal', 'ohne Anfang', 'ohne Ende',

  // Pessoa-nahe / heteronymische Atmosphäre
  'Livro', 'Livro do Desassossego', 'Bernardo Soares',
  'Álvaro de Campos', 'Alberto Caeiro', 'Ricardo Reis',
  'Fernando Pessoa', 'ortónimo', 'heteronímia', 'semi-heterónimo',
  'desdobramento', 'máscara', 'persona', 'alter ego',
];
    const seps = ['  ·  ', '   ', '  /  ', '  //  '];

    // Jeder Node = 2–3 Fetzen zusammen
    function makeText() {
      const k = 2 + ((Math.random() * 2) | 0);
      const parts = [];
      for (let i = 0; i < k; i++) parts.push(pool[(Math.random() * pool.length) | 0]);
      return parts.join(seps[(Math.random() * seps.length) | 0]);
    }

    let W = 0, H = 0, dpr = 1;
    let nodes = [];
    let raf = 0;
    const rand = (a, b) => a + Math.random() * (b - a);

    function build() {
      const count = Math.min(MAX_NODES, Math.floor((W * H) / DENSITY));
      nodes = Array.from({ length: count }, () => ({
        x: Math.random() * W,
        y: Math.random() * H,
        vx: rand(-SPEED, SPEED),
        vy: rand(-SPEED, SPEED),
        t: makeText(),
        s: rand(10, 15),
        a: rand(0.12, 0.36),
        amber: Math.random() < 0.12,
      }));
    }

    function resize() {
      if (!ctx) return;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = canvas.clientWidth;
      H = canvas.clientHeight;
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      build();
    }

    function drawLinks() {
      if (!ctx) return;
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const dx = nodes[i].x - nodes[j].x;
          const dy = nodes[i].y - nodes[j].y;
          const d2 = dx * dx + dy * dy;
          if (d2 < LINK_DIST * LINK_DIST) {
            const d = Math.sqrt(d2);
            const t = 1 - d / LINK_DIST;
            const amber = nodes[i].amber || nodes[j].amber;
            ctx.strokeStyle = amber
              ? `rgba(${AR}, ${AG}, ${AB}, ${t * 0.16})`
              : `rgba(232, 230, 225, ${t * 0.09})`;
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(nodes[i].x, nodes[i].y);
            ctx.lineTo(nodes[j].x, nodes[j].y);
            ctx.stroke();
          }
        }
      }
    }

    function drawNodes() {
      if (!ctx) return;
      for (const p of nodes) {
        ctx.font = `500 ${p.s}px 'Literata Variable', Georgia, serif`;
        ctx.fillStyle = p.amber
          ? `rgba(${AR}, ${AG}, ${AB}, ${p.a + 0.06})`
          : `rgba(232, 230, 225, ${p.a})`;
        ctx.fillText(p.t, p.x, p.y);
      }
    }

    function step() {
      for (const p of nodes) {
        p.x += p.vx;
        p.y += p.vy;
        if (p.y < -20) p.y = H + 20;
        if (p.y > H + 20) p.y = -20;
        if (p.x < -140) p.x = W + 140;
        if (p.x > W + 140) p.x = -140;
      }
    }

    function frame() {
      if (!ctx) return;
      ctx.clearRect(0, 0, W, H);
      step();
      drawLinks();
      drawNodes();
      raf = requestAnimationFrame(frame);
    }

    function drawStatic() {
      if (!ctx) return;
      ctx.clearRect(0, 0, W, H);
      drawLinks();
      drawNodes();
    }

    function start() {
      cancelAnimationFrame(raf);
      resize();
      if (reduce.matches) { drawStatic(); return; }
      raf = requestAnimationFrame(frame);
    }

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) cancelAnimationFrame(raf);
      else if (!reduce.matches) raf = requestAnimationFrame(frame);
    });

    let rt;
    window.addEventListener('resize', () => {
      clearTimeout(rt);
      rt = window.setTimeout(start, 150);
    });
    reduce.addEventListener?.('change', start);

    if (document.fonts?.ready) document.fonts.ready.then(start);
    else start();
  }
</script>
