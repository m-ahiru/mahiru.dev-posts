---
// Posts als Stationen an einem gestrichelten Pfad, nach Jahr gruppiert.
import { fmtDate, readingTime, type Post } from '../lib/posts';

interface Props { entries: Post[] }
const { entries } = Astro.props;

const years = new Map<number, Post[]>();
for (const e of entries) {
  const y = e.data.date.getFullYear();
  if (!years.has(y)) years.set(y, []);
  years.get(y)!.push(e);
}
---

{[...years].map(([year, list]) => (
  <>
    <div class="year"><span>{year}</span></div>
    <ul class="trail">
      {list.map((e) => (
        <li>
          <a href={`/posts/${e.id}`}>
            <span class="date meta">{fmtDate(e.data.date)}</span>
            <span class="node" aria-hidden="true"><span></span></span>
            {e.data.cover ? (
              <span class="polaroid"><img src={e.data.cover} alt="" loading="lazy" decoding="async" /></span>
            ) : (
              <span class="polaroid empty" aria-hidden="true"></span>
            )}
            <span class="body">
              <span class="meta">
                {e.data.work && <span>{e.data.work}</span>}
                {e.data.author && <span>· {e.data.author}</span>}
                <span>· {readingTime(e.body)} min read</span>
                {e.data.unfinished && <span class="tag">unfinished</span>}
              </span>
              <span class="title">{e.data.title}</span>
              {e.data.description && <span class="desc">{e.data.description}</span>}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </>
))}
