---
// Fixer Hintergrund: Punktraster, drei langsam treibende Lichter, feines Korn.
---

<div class="backdrop" aria-hidden="true">
  <span class="ring" style="left:62%;top:-18vh;width:900px;height:900px"></span>
  <span class="ring" style="left:-26vw;top:58vh;width:1000px;height:1000px"></span>
  <span class="glow g1"></span>
  <span class="glow g2"></span>
  <span class="glow g3"></span>
  <svg class="grain" xmlns="http://www.w3.org/2000/svg">
    <filter id="grain-f">
      <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" stitchTiles="stitch" />
      <feColorMatrix type="saturate" values="0" />
    </filter>
    <rect width="100%" height="100%" filter="url(#grain-f)" />
  </svg>
</div>
