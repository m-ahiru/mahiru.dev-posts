---
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import { getPosts } from '../../lib/posts';

const entries = await getPosts();
const total = entries.length;
---

<Base title="posts — mahiru" active="posts" description="Posts" image="/og-posts.png?v=2">
  <section class="wrap page-head">
    <h1 class="page-title">Posts<span class="dot">.</span></h1>
    <span class="page-count">[{String(total).padStart(2, '0')}]</span>
  </section>

  <section class="wrap">
    {total === 0 ? (
      <p style="color:var(--fg-dim)">Nothing here yet.</p>
    ) : (
      <EntryList entries={entries} />
    )}
  </section>
</Base>
