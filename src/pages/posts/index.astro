---
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('posts'))
  .filter((e) => !e.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const total = entries.length;
---

<Base title="posts — mahiru" active="posts" description="Posts">
  <section class="wrap index-head">
    <span class="eyebrow">Index</span>
    <div style="display:flex;align-items:baseline;gap:1rem;flex-wrap:wrap;margin-top:0.6rem;">
      <h1 class="index-title">posts</h1>
      <span class="index-count">[{String(total).padStart(2, '0')}]</span>
    </div>
  </section>

  <section class="wrap">
    <div class="panel">
      {total === 0 ? (
        <p style="color:var(--fg-dim);font-family:var(--body);font-size:0.95rem;">
          Noch leer. Leg eine <code>.md</code> in <code>src/content/posts/</code> ab.
        </p>
      ) : (
        <EntryList entries={entries} total={total} />
      )}
    </div>
  </section>
</Base>
