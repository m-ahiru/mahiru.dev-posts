---
import Base from '../layouts/Base.astro';
import characters from '../data/characters.json';
import media from '../data/media.json';

// ─────────────────────────────────────────────────────────────
// Countdown-Reise: startet beim letzten Platz, #1 kommt zum Schluss.
// Die Anzahl ("My top X …") kommt automatisch aus der Länge der JSON.
// ─────────────────────────────────────────────────────────────
type Entry = { name: string; work?: string; author?: string; image: string; alt?: string };

const W = 2800;      // Weltbreite der Karte
const GAP = 820;     // Abstand zwischen zwei Stationen
const ROTS = [-7, 4, -3, 8, -5, 6, -2, 5, -6, 3, -4, 7, -8];

function buildSet(key: string, label: string, list: Entry[]) {
  const N = list.length;
  const H = 700 + N * GAP + 700;
  const px = (k: number) => (k === N - 1 ? W / 2 : W / 2 + Math.sin(k * 1.15 + 0.4) * 680);
  const py = (k: number) => 700 + k * GAP + (k === N - 1 ? 120 : 0);
  // Station k = 0 ist der letzte Platz, k = N-1 ist #1
  const stops = Array.from({ length: N }, (_, k) => {
    const rank = N - k;
    const e = list[rank - 1];
    return { k, rank, n: String(rank).padStart(2, '0'), x: px(k), y: py(k), rot: ROTS[k % ROTS.length], last: k === N - 1, ...e };
  });
  const contours = Array.from({ length: Math.ceil(N / 2) + 2 }, (_, k) => {
    const x = (k % 2 ? W * 0.2 : W * 0.8) + Math.sin(k * 2.3) * 200;
    const y = 300 + k * GAP * 2.1;
    const a = 260 + (k % 3) * 60;
    return [a, a + 160, a + 340].map((r) => ({ l: x - r, t: y - r, d: 2 * r }));
  }).flat();
  return { key, label, N, H, stops, contours, points: stops.map((s) => `${s.x},${s.y}`).join(' ') };
}

const sets = [
  buildSet('chars', 'characters', characters as Entry[]),
  buildSet('media', 'media', media as Entry[]),
];
---

<Base title="rankings — mahiru" active="rankings" description="Rankings" image="/og-rankings.png">
  <section class="journey" data-journey>
    <div class="j-stage">
      {sets.map((set, si) => (
        <div class="j-set" data-set={set.key} data-n={set.N} data-w={W} data-h={set.H} hidden={si !== 0}>
          <div class="j-world">
            <svg class="j-map" aria-hidden="true" preserveAspectRatio="none" viewBox={`0 0 ${W} ${set.H}`}>
              <g class="j-rings">
                {set.contours.map((c) => <circle cx={c.l + c.d / 2} cy={c.t + c.d / 2} r={c.d / 2} />)}
              </g>
              <polyline points={set.points} class="j-path-base" />
              <polyline points={set.points} class="j-path-draw" />
            </svg>
            {set.stops.map((s) => (
              <div class={`j-node${s.last ? ' is-final' : ''}`} data-x={s.x} data-y={s.y}>
                <div class="j-node-in">
                  {s.last && <span class="j-pulse" aria-hidden="true"><span></span><span></span></span>}
                  <span class="polaroid" style={`transform:rotate(${(s.rot * 0.35).toFixed(1)}deg)`}>
                    <img src={s.image} alt="" loading="lazy" decoding="async" />
                  </span>
                  <span class="j-node-num">{s.n}</span>
                </div>
              </div>
            ))}
          </div>

          <div class="j-intro">
            <h1 class="j-intro-inner">
              <span class="j-i-top">My top</span>
              <span class="j-i-num">{set.N}</span>
              <span class="j-i-bottom">favorite <em>{set.label}.</em></span>
            </h1>
          </div>

          {set.stops.map((s) => (
            <article class={`j-page${s.last ? ' is-final' : ''}`} data-k={s.k} aria-label={`#${s.rank} ${s.name}`}>
              <div class="j-page-img"><img src={s.image} alt={s.alt ?? s.name} loading="lazy" decoding="async" /></div>
              <div class="j-page-body">
                <div class="j-page-top meta">
                  <span>{s.last ? 'N° 01 · THE FAVORITE' : set.key === 'chars' ? 'CHARACTER' : 'MEDIA'}</span>
                  <span>{s.n} / {String(set.N).padStart(2, '0')}</span>
                </div>
                <span class="j-page-num" aria-hidden="true">{s.n}</span>
                <div class="j-page-text">
                  <h2>{s.name}</h2>
                  <span class="j-line"></span>
                  {s.work && <span class="j-work">{s.work}</span>}
                  {s.author && <span class="j-author meta">{s.author}</span>}
                </div>
              </div>
            </article>
          ))}

          <div class="j-minimap" aria-hidden="true">
            <svg viewBox={`0 0 ${W} ${set.H}`} preserveAspectRatio="xMidYMid meet">
              <polyline points={set.points} />
              {set.stops.map((s) => <circle class="j-mm-dot" cx={s.x} cy={s.y} r="80" />)}
              <rect class="j-mm-view" x="0" y="0" width="0" height="0" />
            </svg>
          </div>
        </div>
      ))}

      <div class="j-veil" aria-hidden="true"></div>
      <div class="j-vignette" aria-hidden="true"></div>

      <div class="j-toggle" role="tablist" aria-label="Category">
        <span class="j-slider" aria-hidden="true"></span>
        <button role="tab" aria-selected="true" data-tab="chars">Characters</button>
        <button role="tab" aria-selected="false" data-tab="media">Media</button>
      </div>

      <div class="j-counter" aria-hidden="true">
        <span class="j-total meta"></span>
        <span class="j-bar"><span></span></span>
        <span class="j-cur"></span>
      </div>

      <div class="j-hint" aria-hidden="true"><span>SCROLL</span><i></i></div>
    </div>
  </section>

  <script>
    // Performance: keine riesigen Ebenen mehr. Die Karte ist ein bildschirmgroßes SVG,
    // dessen viewBox die "Kamera" ist; Stationen & Seiten werden einzeln positioniert.
    const root = document.querySelector<HTMLElement>('[data-journey]');
    if (root) {
      const stage = root.querySelector<HTMLElement>('.j-stage')!;
      const veil = root.querySelector<HTMLElement>('.j-veil')!;
      const hint = root.querySelector<HTMLElement>('.j-hint')!;
      const curEl = root.querySelector<HTMLElement>('.j-cur')!;
      const totEl = root.querySelector<HTMLElement>('.j-total')!;
      const barEl = root.querySelector<HTMLElement>('.j-bar span')!;
      const tabs = [...root.querySelectorAll<HTMLButtonElement>('.j-toggle button')];
      const slider = root.querySelector<HTMLElement>('.j-slider')!;
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

      const INTRO = 0.45, END = 0.45;
      const ROTS = [-7, 4, -3, 8, -5, 6, -2, 5, -6, 3, -4, 7, -8];
      const clamp = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v));
      const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

      type Page = { el: HTMLElement; img: HTMLElement | null; num: HTMLElement | null };
      type Node = { el: HTMLElement; x: number; y: number };
      type SetState = {
        el: HTMLElement; N: number; W: number; H: number;
        world: HTMLElement; map: SVGSVGElement; rings: SVGGElement;
        base: SVGPolylineElement; draw: SVGPolylineElement;
        pts: [number, number][]; seg: number[]; len: number;
        pages: Page[]; nodes: Node[]; dots: SVGCircleElement[];
        intro: HTMLElement; mmView: SVGRectElement;
      };

      const sets = new Map<string, SetState>();
      root.querySelectorAll<HTMLElement>('.j-set').forEach((el) => {
        const draw = el.querySelector<SVGPolylineElement>('.j-path-draw')!;
        const pts = draw.getAttribute('points')!.split(' ').map((p) => p.split(',').map(Number) as [number, number]);
        const seg = pts.map((p, i) => (i ? Math.hypot(p[0] - pts[i - 1][0], p[1] - pts[i - 1][1]) : 0));
        const len = seg.reduce((a, b) => a + b, 0);
        draw.setAttribute('stroke-dasharray', String(len));
        sets.set(el.dataset.set!, {
          el, N: +el.dataset.n!, W: +el.dataset.w!, H: +el.dataset.h!,
          world: el.querySelector('.j-world')!,
          map: el.querySelector('.j-map')!,
          rings: el.querySelector('.j-rings')!,
          base: el.querySelector('.j-path-base')!,
          draw, pts, seg, len,
          pages: [...el.querySelectorAll<HTMLElement>('.j-page')].map((p) => ({
            el: p, img: p.querySelector('.j-page-img img'), num: p.querySelector('.j-page-num'),
          })),
          nodes: [...el.querySelectorAll<HTMLElement>('.j-node')].map((n) => ({ el: n, x: +n.dataset.x!, y: +n.dataset.y! })),
          dots: [...el.querySelectorAll<SVGCircleElement>('.j-mm-dot')],
          intro: el.querySelector('.j-intro')!,
          mmView: el.querySelector('.j-mm-view')!,
        });
      });

      let active = sets.get('chars')!;
      let step = 900, vw = 0, vh = 0;
      let target = 0, gs = 0, raf = 0;

      const progress = () => {
        const y = clamp(-root!.getBoundingClientRect().top, 0, root!.offsetHeight);
        return clamp(y / step - INTRO, -INTRO, active.N - 1 + END);
      };

      function layout() {
        vw = stage.clientWidth;
        vh = stage.clientHeight;
        step = Math.max(720, vh * 1.05);
        root!.style.height = `${Math.round((active.N - 1 + END + INTRO) * step + vh)}px`;
        totEl.textContent = String(active.N).padStart(2, '0');
        target = gs = progress();
        render(gs);
      }

      function render(g: number) {
        const S = active, N = S.N;
        const i0 = clamp(Math.floor(g), 0, N - 1), t = g < 0 ? 0 : g - Math.floor(g);
        const i1 = Math.min(i0 + 1, N - 1);
        const mv = ease(clamp((t - 0.5) / 0.4, 0, 1));
        const [x0, y0] = S.pts[i0], [x1, y1] = S.pts[i1];
        const cx = x0 + (x1 - x0) * mv, cy = y0 + (y1 - y0) * mv;

        const pres = (d: number, last: boolean) => {
          if (d < -0.2) return 0;
          if (d < 0) return ease((d + 0.2) / 0.2);
          if (d <= 0.45 || last) return 1;
          if (d < 0.7) return 1 - ease((d - 0.45) / 0.25);
          return 0;
        };

        const mobile = vw < 760;
        const PX = vw / 2 - (mobile ? 46 : 110), PY = vh - (mobile ? 70 : 110) - vh / 2;
        const pileScale = mobile ? 0.2 : 0.14;
        let veilV = 0;

        S.pages.forEach((p, k) => {
          const last = k === N - 1, d = g - k;
          veilV = Math.max(veilV, pres(d, last));
          // nur sichtbar: kommende kurz vor Eintritt, aktuelle, und die obersten 4 im Stapel
          const visible = d >= -0.2 && d < 4.8;
          p.el.style.visibility = visible ? 'visible' : 'hidden';
          if (!visible) return;
          let tf = '', filt = 'none';
          if (d < 0) {
            const q = 1 - ease((d + 0.2) / 0.2);
            tf = `translateY(${(q * vh * 0.92).toFixed(0)}px) rotate(${(q * 4).toFixed(2)}deg)`;
          } else if (d > 0.45 && !last) {
            const q = ease(clamp((d - 0.45) / 0.3, 0, 1));
            const sc = 1 - q * (1 - pileScale), r = ROTS[k % 13] * q;
            tf = `translate(${(PX * q).toFixed(0)}px,${((PY - k * 4) * q).toFixed(0)}px) scale(${sc.toFixed(3)}) rotate(${r.toFixed(1)}deg)`;
            filt = `brightness(${(1 - q * 0.35).toFixed(2)})`;
          }
          p.el.style.transform = `translate(-50%,-50%) ${tf}`;
          p.el.style.filter = filt;
          if (p.img) p.img.style.transform = `scale(${(1.08 - clamp(d + 0.2, 0, 0.65) * 0.12).toFixed(3)})`;
          if (p.num) p.num.style.transform = `translateY(${(clamp(-d, -1, 1) * 90).toFixed(0)}px)`;
        });

        // Kamera
        const base = clamp(Math.min(vw / 1440, vh / 900), 0.42, 1.15);
        const z = (g < 0 ? 0.55 + 0.2 * (1 + g / INTRO) : 0.72 + 0.38 * veilV) * base;
        const r = Math.sin(g * 0.9) * 2;
        const ox = vw / 2, oy = vh * 0.52;
        S.world.style.transform = `rotate(${r.toFixed(2)}deg)`;
        S.map.setAttribute('viewBox', `${(cx - ox / z).toFixed(1)} ${(cy - oy / z).toFixed(1)} ${(vw / z).toFixed(1)} ${(vh / z).toFixed(1)}`);
        const sw = 1 / z;
        S.rings.setAttribute('stroke-width', sw.toFixed(3));
        S.base.setAttribute('stroke-width', (1.5 * sw).toFixed(3));
        S.base.setAttribute('stroke-dasharray', `${(3 * sw).toFixed(2)} ${(9 * sw).toFixed(2)}`);
        S.draw.setAttribute('stroke-width', (2 * sw).toFixed(3));
        let drawn = 0;
        for (let k = 1; k <= i0; k++) drawn += S.seg[k];
        if (i1 > i0) drawn += S.seg[i1] * mv;
        S.draw.setAttribute('stroke-dashoffset', String(S.len - drawn));

        const margin = 420 * z;
        S.nodes.forEach((n, k) => {
          const sx = ox + (n.x - cx) * z, sy = oy + (n.y - cy) * z;
          const on = sx > -margin && sx < vw + margin && sy > -margin && sy < vh + margin;
          n.el.style.visibility = on ? 'visible' : 'hidden';
          if (on) {
            const near = clamp(1 - Math.abs(g - k) * 1.6, 0, 1);
            n.el.style.transform = `translate(${sx.toFixed(1)}px,${sy.toFixed(1)}px) scale(${z.toFixed(3)})`;
            n.el.style.opacity = g >= k - 0.2 ? (0.35 + 0.65 * near).toFixed(2) : '0.12';
            n.el.style.filter = near > 0.98 ? 'none' : `grayscale(${(1 - near).toFixed(2)})`;
          }
          S.dots[k]?.classList.toggle('on', g >= k);
        });

        veil.style.opacity = (veilV * 0.9).toFixed(2);
        // Intro löst sich beim ersten Scrollen auf (0 = voll da, 1 = weg)
        const out = clamp((g + INTRO) / (INTRO * 0.75), 0, 1);
        S.intro.style.setProperty('--out', out.toFixed(3));
        S.intro.style.visibility = out >= 1 ? 'hidden' : 'visible';
        hint.classList.toggle('is-gone', g >= -0.3);

        S.mmView.setAttribute('x', (cx - vw / z / 2).toFixed(0));
        S.mmView.setAttribute('y', (cy - vh / z / 2).toFixed(0));
        S.mmView.setAttribute('width', (vw / z).toFixed(0));
        S.mmView.setAttribute('height', (vh / z).toFixed(0));

        const cur = g < 0 ? N : N - Math.round(clamp(g, 0, N - 1));
        curEl.textContent = String(cur).padStart(2, '0');
        barEl.style.width = `${(((g + INTRO) / (N - 1 + END + INTRO)) * 100).toFixed(1)}%`;
      }

      // weiches Nachziehen statt CSS-Transitions (alles bleibt synchron)
      function tick() {
        const diff = target - gs;
        gs = reduce || Math.abs(diff) < 0.0008 ? target : gs + diff * 0.14;
        render(gs);
        raf = gs !== target ? requestAnimationFrame(tick) : 0;
      }
      function onScroll() {
        target = progress();
        if (!raf) raf = requestAnimationFrame(tick);
      }

      function select(key: string) {
        const next = sets.get(key);
        if (!next || next === active) return;
        active.el.hidden = true;
        next.el.hidden = false;
        active = next;
        tabs.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tab === key)));
        slider.dataset.pos = key;
        const top = root!.getBoundingClientRect().top + window.scrollY;
        window.scrollTo({ top, behavior: 'instant' as ScrollBehavior });
        layout();
      }
      tabs.forEach((b) => b.addEventListener('click', () => select(b.dataset.tab!)));

      addEventListener('scroll', onScroll, { passive: true });
      // Mobile: Adressleiste ein/aus löst resize aus -> nur bei echter Größenänderung neu rechnen
      let lastW = innerWidth, lastH = innerHeight;
      addEventListener('resize', () => {
        if (innerWidth === lastW && Math.abs(innerHeight - lastH) < 160) return;
        lastW = innerWidth; lastH = innerHeight;
        layout();
      });
      layout();
    }
  </script>
</Base>

<style is:global>
  /* ============ Rankings-Reise ============ */
  /* startet unter dem (durchsichtigen) Header -> nichts verrutscht am Anfang */
  .journey { position: relative; margin-top: calc((var(--header-h) + 1px) * -1); }
  .j-stage { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; }
  .j-set[hidden] { display: none; }

  .j-world { position: absolute; inset: 0; transform-origin: 50% 52%; }
  .j-map { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .j-map polyline, .j-map circle { fill: none; }
  .j-rings { stroke: color-mix(in srgb, var(--accent) 9%, transparent); }
  .j-path-base { stroke: var(--fg-ghost); }
  .j-path-draw { stroke: var(--accent); }

  .j-node { position: absolute; left: 0; top: 0; width: 0; height: 0; transform-origin: 0 0; visibility: hidden; }
  .j-node-in { position: absolute; left: -120px; top: -116px; width: 240px; display: flex; flex-direction: column; align-items: center; gap: 14px; }
  .j-node .polaroid { width: 216px; padding: 8px; box-shadow: 0 30px 70px rgba(0, 0, 0, 0.8); }
  .j-node-num { font-family: var(--display); font-weight: 700; font-size: 64px; line-height: 1; letter-spacing: -0.04em; color: transparent; -webkit-text-stroke: 1.2px var(--accent); }
  .j-node.is-final .j-node-in { left: -170px; top: -170px; width: 340px; }
  .j-node.is-final .polaroid { width: 316px; }
  .j-node.is-final .j-node-num { font-size: 120px; }
  .j-pulse { position: absolute; left: 170px; top: 130px; width: 0; height: 0; }
  .j-pulse span { position: absolute; left: -210px; top: -210px; width: 420px; height: 420px; border-radius: 50%; border: 1px solid color-mix(in srgb, var(--accent) 60%, transparent); animation: j-pulse 2.4s var(--ease-out) infinite; }
  .j-pulse span + span { animation-delay: 1.2s; }
  @keyframes j-pulse { 0% { transform: scale(0.6); opacity: 0.9; } 100% { transform: scale(1.8); opacity: 0; } }

  .j-veil { position: absolute; inset: 0; background: rgba(0, 0, 0, 0.72); opacity: 0; pointer-events: none; }
  .j-vignette { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse at center, transparent 45%, rgba(0, 0, 0, 0.85) 100%); }

  .j-intro { --out: 0; position: absolute; inset: 0; z-index: 5; display: flex; align-items: center; justify-content: center; padding: var(--header-h) var(--page-x) 0; pointer-events: none; opacity: calc(1 - var(--out)); }
  .j-intro-inner { position: relative; display: grid; justify-items: center; font-weight: 400; line-height: 1; }
  .j-i-num {
    font-family: var(--display); font-weight: 700; font-style: normal;
    font-size: clamp(11rem, 34vw, 24rem); line-height: 0.8; letter-spacing: -0.06em;
    background: linear-gradient(170deg, #f3ecff 0%, #d6c2ff 30%, var(--accent) 58%, #5d43b8 100%);
    background-size: 100% 200%;
    -webkit-background-clip: text; background-clip: text; color: transparent;
    filter: drop-shadow(0 0 60px color-mix(in srgb, var(--accent) 35%, transparent)) blur(calc(var(--out) * 10px));
    transform: scale(calc(1 + var(--out) * 0.35));
    animation: j-rise 1.4s var(--ease-out) 0.15s both, j-sheen 7s ease-in-out 1.6s infinite alternate;
  }
  .j-i-top, .j-i-bottom { font-family: var(--display); font-style: italic; font-weight: 500; letter-spacing: -0.02em; color: var(--fg); white-space: nowrap; }
  .j-i-top {
    justify-self: start; margin: 0 0 -0.35em -0.4em; font-size: clamp(2rem, 5.5vw, 4.25rem); position: relative; z-index: 1;
    transform: translateX(calc(var(--out) * -120px)); animation: j-rise 1.1s var(--ease-out) 0s both;
  }
  .j-i-bottom {
    justify-self: end; margin: -0.28em -0.5em 0 0; font-size: clamp(2.2rem, 6.5vw, 5rem); position: relative; z-index: 1;
    transform: translateX(calc(var(--out) * 120px)); animation: j-rise 1.1s var(--ease-out) 0.45s both;
  }
  .j-i-bottom em { color: var(--accent); }
  .j-i-top::after { content: ''; display: block; width: 0.9em; height: 1.5px; margin-top: 0.2em; background: var(--accent); }
  @keyframes j-rise { from { opacity: 0; transform: translateY(40px); filter: blur(12px); } }
  @keyframes j-sheen { to { background-position: 0 100%; } }

  .j-page {
    position: absolute; left: 50%; top: calc(50% + 20px); z-index: 10;
    width: min(1060px, 90vw); height: min(540px, 70vh);
    display: flex; overflow: hidden; background: var(--panel);
    border: 1px solid rgba(255, 255, 255, 0.09); border-radius: 6px;
    box-shadow: 0 40px 120px rgba(0, 0, 0, 0.85);
    visibility: hidden;
  }
  .j-page-img { flex-shrink: 0; height: 100%; aspect-ratio: 1 / 1; overflow: hidden; background: var(--bg-inset); }
  .j-page-img img { width: 100%; height: 100%; object-fit: cover; }
  .j-page-body { position: relative; flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: space-between; padding: clamp(1.5rem, 3.5vw, 2.75rem) clamp(1.5rem, 3.5vw, 3rem); }
  .j-page-top { display: flex; justify-content: space-between; font-size: 0.68rem; letter-spacing: 0.16em; }
  .j-page-num { position: absolute; right: 1.9rem; top: 4rem; font-family: var(--display); font-weight: 700; font-size: clamp(8rem, 16vw, 13.75rem); line-height: 1; letter-spacing: -0.05em; color: transparent; -webkit-text-stroke: 1.5px color-mix(in srgb, var(--accent) 50%, transparent); pointer-events: none; }
  .j-page-text { position: relative; display: flex; flex-direction: column; gap: 1rem; }
  .j-page-text h2 { font-family: var(--display); font-style: italic; font-weight: 600; font-size: clamp(2.2rem, 4.5vw, 3.9rem); line-height: 0.98; letter-spacing: -0.025em; text-wrap: balance; }
  .j-line { display: block; width: 72px; height: 1.5px; background: var(--accent); }
  .j-work { font-style: italic; font-size: 1.3rem; color: var(--fg-dim); }
  .j-author { text-transform: uppercase; letter-spacing: 0.08em; }
  .j-page.is-final { border-color: var(--accent); animation: j-glow 3s ease-in-out infinite; }
