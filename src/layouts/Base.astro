---
import '../styles/global.css';
import ParticleField from '../components/ParticleField.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** which nav item is active: 'home' | 'posts' */
  active?: 'home' | 'posts' | 'rankings' | undefined;
  /** show the reading progress bar (post pages) */
  progress?: boolean;
  /** Share-Bild fürs Embed (og:image), z.B. "/covers/xyz.jpg" */
  image?: string;
}

const { title, description = 'Posts', active, progress = false, image } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(image ?? '/og-mahiru.png', Astro.site).toString();
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#b490fc" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    {progress && <ReadingProgress />}
    <ParticleField />

    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/" aria-label="Startseite">
          <span class="sigil">~/</span><span>mahiru</span>
        </a>
        <nav class="nav" aria-label="Hauptnavigation">
          <a href="/" aria-current={active === 'home' ? 'page' : undefined}>index</a>
          <a href="/posts" aria-current={active === 'posts' ? 'page' : undefined}>posts</a>
          <a href="/rankings" aria-current={active === 'rankings' ? 'page' : undefined}>rankings</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>
